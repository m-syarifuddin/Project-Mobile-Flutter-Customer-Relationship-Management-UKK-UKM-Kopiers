router.post(
  '/',
  authorize('admin'),
  async (req, res, next) => {
    let connection;
    let transactionStarted = false;

    try {
      const input = z.object({
        name: z.string().trim().min(1).max(140),

        description: z.string()
          .trim()
          .max(5000)
          .optional()
          .nullable(),

        campaign_type: z.enum([
          'new_customer',
          'loyal',
          'reengagement',
          'personalized',
        ]),

        target_dimension: z.enum([
          'activity',
          'loyalty',
          'customer_value',
        ]),

        target_segment: z.string().min(1),

        discount_percent: z.number()
          .min(0)
          .max(100)
          .optional()
          .nullable(),

        starts_at: z.string().datetime(),
        ends_at: z.string().datetime(),

        conditions: z.record(
          z.string(),
          z.unknown()
        ).optional(),
      }).refine(
        (data) =>
          new Date(data.ends_at) > new Date(data.starts_at),
        {
          message: 'Tanggal berakhir harus setelah tanggal mulai.',
          path: ['ends_at'],
        }
      ).parse(req.body);

      if (
        !TARGET_DIMENSIONS[input.target_dimension]
          ?.includes(input.target_segment)
      ) {
        return res.status(400).json({
          error: 'Target segmentasi tidak valid.',
        });
      }

      connection = await pool.getConnection();

      await connection.beginTransaction();
      transactionStarted = true;

      const [result] = await connection.execute(
        `INSERT INTO campaigns (
           name,
           description,
           campaign_type,
           target_dimension,
           target_segment,
           discount_percent,
           starts_at,
           ends_at,
           conditions,
           created_by
         ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
        [
          input.name,
          input.description || null,
          input.campaign_type,
          input.target_dimension,
          input.target_segment,
          input.discount_percent ?? null,
          input.starts_at,
          input.ends_at,
          JSON.stringify(input.conditions || {}),
          req.user.id,
        ]
      );

      const rules = await getSegmentationRules(connection);

      const audience = await refreshCampaignAudience(
        connection,
        result.insertId,
        input.target_dimension,
        input.target_segment,
        rules
      );

      await connection.commit();
      transactionStarted = false;

      return res.status(201).json({
        id: result.insertId,
        target_dimension: input.target_dimension,
        target_segment: input.target_segment,
        audience_count: audience.audience_count,
        message: 'Kampanye berhasil dibuat.',
      });
    } catch (error) {
      if (connection && transactionStarted) {
        await connection.rollback();
      }

      return next(error);
    } finally {
      if (connection) {
        connection.release();
      }
    }
  }
);

