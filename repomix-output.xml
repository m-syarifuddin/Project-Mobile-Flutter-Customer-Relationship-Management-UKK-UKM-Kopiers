              mainAxisSize: MainAxisSize.min,

              crossAxisAlignment: CrossAxisAlignment.start,

              children: [

                const Text(

                  'Pilih pelanggan dan produk yang dibeli.',

                  style: TextStyle(fontSize: 13),

                ),

                const SizedBox(height: 16),

                Row(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Expanded(
                      child: DropdownButtonFormField<int>(
                        initialValue: _customerId,
                        isExpanded: true,
                        decoration: const InputDecoration(
                          labelText: 'Pilih customer',
                          prefixIcon: Icon(
                            Icons.person_rounded,
                            color: coffee,
                          ),
                        ),
                        items: widget.customers.map((customer) {
                          return DropdownMenuItem<int>(
                            value: (customer['id'] as num).toInt(),
                            child: Text(
                              '${customer['name']} · ${customer['phone']}',
                              overflow: TextOverflow.ellipsis,
                            ),
                          );
                        }).toList(),
                        onChanged: _saving
                            ? null
                            : (value) {
                                setState(() {
                                  _customerId = value;
                                  _voucherCode = '';
                                  _voucherController.clear();
                                });
                              },
                      ),
                    ),
                    const SizedBox(width: 8),
                    SizedBox(
                      height: 56,
                      child: FilledButton.icon(
                        onPressed: _saving ? null : _scanMember,
                        icon: const Icon(Icons.qr_code_scanner_rounded),
                        label: const Text('Scan Member'),
                        style: FilledButton.styleFrom(
                          backgroundColor: coffee,
                          foregroundColor: Colors.white,
                          padding: const EdgeInsets.symmetric(horizontal: 12),
                          shape: RoundedRectangleBorder(
                            borderRadius: BorderRadius.circular(12),
                          ),
                        ),
                      ),
                    ),
                  ],
                ),

                const SizedBox(height: 12),

                DropdownButtonFormField<int>(

                  initialValue: _productId,

                  isExpanded: true,

                  decoration: const InputDecoration(

                    labelText: 'Pilih produk',

                    prefixIcon: Icon(

                      Icons.local_cafe_rounded,

                      color: coffee,

                    ),

                  ),

                  items: widget.products.map((product) {

                    return DropdownMenuItem<int>(

                      value: (product['id'] as num).toInt(),

                      child: Text(

                        '${product['name']} · '

                        '${_adminMoney(product['price'])}',

                        overflow: TextOverflow.ellipsis,

                      ),

                    );

                  }).toList(),

                  onChanged: _saving

                      ? null

                      : (value) {

                          setState(() => _productId = value);

                        },

                ),

                const SizedBox(height: 12),

                Row(

                  children: [

                    Expanded(

                      child: TextFormField(

                        key: const ValueKey('transaction-quantity'),

                        initialValue: '1',

                        keyboardType: TextInputType.number,

                        decoration: const InputDecoration(

                          labelText: 'Jumlah',

                          prefixIcon: Icon(

                            Icons.numbers_rounded,

                            color: coffee,

                          ),

                        ),

                        onChanged: (value) {

                          _quantity = int.tryParse(value) ?? 1;

                        },

                      ),

                    ),

                    const SizedBox(width: 10),

                    FilledButton.icon(

                      onPressed: _saving

                          ? null

                          : () {

                              if (_productId == null || _quantity < 1) {

                                return;

                              }

                              setState(() {

                                final existing = _items.indexWhere(

                                  (item) =>

                                      item['product_id'] == _productId,

                                );

                                if (existing >= 0) {

                                  _items[existing]['quantity'] =

