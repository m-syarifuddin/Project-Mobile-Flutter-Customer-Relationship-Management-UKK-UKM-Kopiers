router.patch(
  '/:id',
  authorize('admin'),
  async (req, res, next) => {
    let connection;
    let transactionStarted = false;

    try {
      const id = z.coerce.number()
        .int()
        .positive()
        .parse(req.params.id);

      const input = z.object({
        name: z.string()
          .trim()
          .min(1)
          .max(140)
          .optional(),

        description: z.string()
          .trim()
          .max(5000)
          .nullable()
          .optional(),

        campaign_type: z.enum([
          'new_customer',
          'loyal',
          'reengagement',
          'personalized',
        ]).optional(),

        target_dimension: z.enum([
          'activity',
          'loyalty',
          'customer_value',
        ]).optional(),

        target_segment: z.string()
          .min(1)
          .optional(),

        discount_percent: z.number()
          .min(0)
          .max(100)
          .nullable()
          .optional(),

        starts_at: z.string()
          .datetime()
          .optional(),

        ends_at: z.string()
          .datetime()
          .optional(),

        conditions: z.record(
          z.string(),
          z.unknown()
        ).optional(),
      }).refine(
        (data) => Object.keys(data).length > 0,
        'Kirim minimal satu nilai untuk diperbarui.'
      ).parse(req.body);

      connection = await pool.getConnection();

      await connection.beginTransaction();
      transactionStarted = true;

      const [currentRows] = await connection.execute(
        `SELECT
           id,
           starts_at,
           ends_at,
           target_dimension,
           target_segment
         FROM campaigns
         WHERE id = ?
         FOR UPDATE`,
        [id]
      );

      if (!currentRows[0]) {
        await connection.rollback();
        transactionStarted = false;

        return res.status(404).json({
          error: 'Kampanye tidak ditemukan.',
        });
      }

      const current = currentRows[0];

      const startsAt =
        input.starts_at || current.starts_at;

      const endsAt =
        input.ends_at || current.ends_at;

      if (new Date(endsAt) <= new Date(startsAt)) {
        await connection.rollback();
        transactionStarted = false;

        return res.status(400).json({
          error: 'Tanggal berakhir harus setelah tanggal mulai.',
        });
      }

      const targetDimension =
        input.target_dimension || current.target_dimension;

      const targetSegment =
        input.target_segment || current.target_segment;

      if (
        !TARGET_DIMENSIONS[targetDimension]
          ?.includes(targetSegment)
      ) {
        await connection.rollback();
        transactionStarted = false;

        return res.status(400).json({
          error: 'Target segmentasi tidak valid.',
        });
      }

      const fields = Object.keys(input);

      const values = fields.map((field) =>
        field === 'conditions'
          ? JSON.stringify(input[field])
          : input[field]
      );

      await connection.execute(
        `UPDATE campaigns
         SET ${fields
           .map((field) => `${field} = ?`)
           .join(', ')}
         WHERE id = ?`,
        [...values, id]
      );

      const targetChanged =
        targetDimension !== current.target_dimension ||
        targetSegment !== current.target_segment;

      let audienceCount;

      if (targetChanged) {
        const rules = await getSegmentationRules(connection);

        const audience = await refreshCampaignAudience(
          connection,
          id,
          targetDimension,
          targetSegment,
          rules
        );

        audienceCount = audience.audience_count;
      }

      await connection.commit();
      transactionStarted = false;

      return res.json({
        message: 'Kampanye berhasil diperbarui.',
        target_dimension: targetDimension,
        target_segment: targetSegment,

        ...(audienceCount !== undefined
          ? { audience_count: audienceCount }
          : {}),
      });
    } catch (error) {
      if (connection && transactionStarted) {
        await connection.rollback();
      }

      return next(error);
    } finally {
      if (connection) {
        connection.release();
      }
    }
  }
);

