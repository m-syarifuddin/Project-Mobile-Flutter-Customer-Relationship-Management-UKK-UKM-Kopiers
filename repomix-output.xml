                        : 'Silahkan masuk jika sudah punya akun.',
                    textAlign: TextAlign.center,
                  ),
                  const SizedBox(height: 22),

                  // Tombol pengaturan server dipindahkan ke bawah logo.
                  Align(
                    alignment: Alignment.centerRight,
                    child: IconButton(
                      tooltip: 'Pengaturan Host Server API',
                      onPressed: () => _showApiSettings(context),
                      icon: const Icon(Icons.dns_outlined),
                    ),
                  ),

                  if (_register) ...[
                    TextFormField(
                      controller: _name,
                      decoration: const InputDecoration(
                        labelText: 'Nama',
                      ),
                      validator: _required,
                    ),
                    const SizedBox(height: 12),
                    TextFormField(
                      controller: _phone,
                      keyboardType: TextInputType.phone,
                      decoration: const InputDecoration(
                        labelText: 'Nomor telepon',
                      ),
                      validator: _required,
                    ),
                    const SizedBox(height: 12),
                    TextFormField(
                      controller: _email,
                      keyboardType: TextInputType.emailAddress,
                      decoration: const InputDecoration(
                        labelText: 'Email (opsional)',
                      ),
                    ),
                    const SizedBox(height: 12),
                    TextFormField(
                      controller: _registerPassword,
                      obscureText: true,
                      decoration: const InputDecoration(
                        labelText: 'Kata sandi (min. 8 karakter)',
                      ),
                      validator: (value) =>
                          value == null || value.length < 8
                              ? 'Minimal 8 karakter'
                              : null,
                    ),
                  ] else ...[
                    TextFormField(
                      controller: _identifier,
                      decoration: const InputDecoration(
                        labelText: 'Nomor telepon atau email',
                      ),
                      validator: _required,
                    ),
                    const SizedBox(height: 12),
                    TextFormField(
                      controller: _password,
                      obscureText: true,
                      decoration: const InputDecoration(
                        labelText: 'Kata sandi',
                      ),
                      validator: _required,
                      onFieldSubmitted: (_) => _submit(),
                    ),
                  ],

                  if (_error != null) ...[
                    const SizedBox(height: 12),
                    Text(
                      _error!,
                      style: const TextStyle(color: Colors.red),
                    ),
                  ],
                  const SizedBox(height: 18),
                  FilledButton(
                    onPressed: _busy ? null : _submit,
                    child: _busy
                        ? const SizedBox(
                            height: 20,
                            width: 20,
