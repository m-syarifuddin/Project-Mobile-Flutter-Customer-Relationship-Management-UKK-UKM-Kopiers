const jwt = require('jsonwebtoken');
const pool = require('../config/database');

async function authenticate(req, res, next) {
  const header = req.get('authorization') || '';
  const [scheme, token] = header.split(' ');
  if (scheme !== 'Bearer' || !token) {
    return res.status(401).json({ error: 'Token autentikasi diperlukan.' });
  }

  try {
    const payload = jwt.verify(token, process.env.JWT_SECRET);
    const [rows] = await pool.execute(
      'SELECT id, role, is_active, token_version FROM users WHERE id = ? LIMIT 1',
      [payload.sub]
    );
    const user = rows[0];
    if (!user || !user.is_active || user.token_version !== payload.ver) {
      return res.status(401).json({ error: 'Sesi tidak berlaku. Silakan login kembali.' });
    }
    req.user = { id: user.id, role: user.role };
    return next();
  } catch (error) {
    if (error.name === 'JsonWebTokenError' || error.name === 'TokenExpiredError') {
      return res.status(401).json({ error: 'Token tidak valid atau sudah kedaluwarsa.' });
    }
    return next(error);
  }
}

function authorize(...roles) {
  return (req, res, next) => {
    if (!req.user || !roles.includes(req.user.role)) {
      return res.status(403).json({ error: 'Anda tidak memiliki izin untuk tindakan ini.' });
    }
    return next();
  };
}

module.exports = { authenticate, authorize };
</file>

<file path="kopiers_api/src/middleware/errors.js">
function notFound(req, res) {
  res.status(404).json({ error: 'Endpoint tidak ditemukan.' });
}

function errorHandler(error, req, res, next) {
  if (res.headersSent) return next(error);

  if (error.name === 'ZodError') {
    return res.status(400).json({
      error: 'Input tidak valid.',
      details: error.issues.map(({ path, message }) => ({ field: path.join('.'), message }))
    });
  }
  if (error.code === 'ER_DUP_ENTRY') {
    return res.status(409).json({ error: 'Data dengan nilai tersebut sudah terdaftar.' });
  }
  if (error.code === 'ER_NO_REFERENCED_ROW_2') {
    return res.status(400).json({ error: 'Referensi data tidak ditemukan.' });
  }
  if (error.type === 'entity.too.large') {
    return res.status(413).json({ error: 'Ukuran gambar maksimal 5 MB.' });
  }

  console.error(error);
  return res.status(500).json({
    error: process.env.NODE_ENV === 'production' ? 'Terjadi kesalahan pada server.' : error.message
  });
}

module.exports = { notFound, errorHandler };
</file>

<file path="kopiers_api/src/routes/auth.js">
const express = require('express');
const bcrypt = require('bcryptjs');
const jwt = require('jsonwebtoken');
const { z } = require('zod');
const pool = require('../config/database');
const { authenticate } = require('../middleware/auth');

const router = express.Router();

const registerSchema = z.object({
  name: z.string().trim().min(2).max(120),
  phone: z.string().trim().min(8).max(32),
  email: z.string().trim().email().max(190).optional().or(z.literal('')),
  password: z.string().min(8).max(72),
});

const loginSchema = z.object({
  identifier: z.string().trim().min(1),
  password: z.string().min(1).max(72),
});

const changePasswordSchema = z.object({
  current_password: z.string().min(1, 'Password lama wajib diisi.'),
  new_password: z
    .string()
    .min(8, 'Password baru minimal 8 karakter.')
    .max(72, 'Password baru maksimal 72 karakter.'),
});

function issueToken(user) {
  return jwt.sign(
    {
      sub: String(user.id),
      role: user.role,
      ver: user.token_version,
    },
    process.env.JWT_SECRET,
    {
      expiresIn: process.env.JWT_EXPIRES_IN || '12h',
      issuer: 'kopiers-api',
      audience: 'kopiers-apps',
    },
  );
}

// REGISTER
router.post('/register', async (req, res, next) => {
  let connection;
  let transactionStarted = false;

  try {
    const input = registerSchema.parse(req.body);

    connection = await pool.getConnection();

    const passwordHash = await bcrypt.hash(
      input.password,
      Number(process.env.BCRYPT_ROUNDS || 12),
    );

    await connection.beginTransaction();
    transactionStarted = true;

    const [result] = await connection.execute(
      `INSERT INTO users
        (name, email, phone, password_hash, role)
       VALUES (?, ?, ?, ?, ?)`,
      [
        input.name,
        input.email || null,
        input.phone,
        passwordHash,
        'customer',
      ],
    );

    await connection.execute(
      'INSERT INTO customers (user_id) VALUES (?)',
      [result.insertId],
    );

    await connection.commit();
    transactionStarted = false;

    return res.status(201).json({
      message: 'Akun customer berhasil dibuat.',
    });
  } catch (error) {
    if (connection && transactionStarted) {
      await connection.rollback();
    }
    return next(error);
  } finally {
    if (connection) connection.release();
  }
});

// LOGIN
router.post('/login', async (req, res, next) => {
  try {
    const input = loginSchema.parse(req.body);

    const [rows] = await pool.execute(
      `SELECT
         id, name, email, phone, password_hash,
         role, is_active, token_version
       FROM users
       WHERE phone = ? OR email = ?
       LIMIT 1`,
      [input.identifier, input.identifier],
    );

    const user = rows[0];

    if (
      !user ||
      !user.is_active ||
      !(await bcrypt.compare(input.password, user.password_hash))
    ) {
      return res.status(401).json({
        error: 'Nomor telepon/email atau kata sandi salah.',
      });
    }

    return res.json({
      token: issueToken(user),
      user: {
        id: user.id,
        name: user.name,
        email: user.email,
        phone: user.phone,
        role: user.role,
      },
    });
  } catch (error) {
    return next(error);
  }
});

// LOGOUT
router.post('/logout', authenticate, async (req, res, next) => {
  try {
    await pool.execute(
      `UPDATE users
       SET token_version = token_version + 1
       WHERE id = ?`,
      [req.user.id],
    );

    return res.json({
      message: 'Logout berhasil.',
    });
  } catch (error) {
    return next(error);
  }
});

// GET PROFIL LOGIN
router.get('/me', authenticate, async (req, res, next) => {
  try {
    const [rows] = await pool.execute(
      `SELECT id, name, email, phone, role, created_at
       FROM users
       WHERE id = ?
       LIMIT 1`,
      [req.user.id],
    );

    if (!rows[0]) {
      return res.status(404).json({
        error: 'Akun tidak ditemukan.',
      });
    }

    return res.json({ user: rows[0] });
  } catch (error) {
    return next(error);
  }
});

// UPDATE PROFIL
router.patch('/me', authenticate, async (req, res, next) => {
  try {
    const input = z.object({
      name: z.string().trim().min(2).max(120).optional(),
      email: z
        .string()
        .trim()
        .email()
        .max(190)
        .optional()
        .or(z.literal('')),
      phone: z.string().trim().min(8).max(32).optional(),
    })
      .refine(
        (data) => Object.keys(data).length > 0,
        'Isi minimal satu data yang ingin diperbarui.',
      )
      .parse(req.body);

    const fields = Object.keys(input);

    const assignments = fields
      .map((field) => `${field} = ?`)
      .join(', ');

    const values = fields.map((field) =>
      input[field] === '' ? null : input[field],
    );

    await pool.execute(
      `UPDATE users SET ${assignments} WHERE id = ?`,
      [...values, req.user.id],
    );

    const [rows] = await pool.execute(
      `SELECT id, name, email, phone, role, created_at
       FROM users
       WHERE id = ?
       LIMIT 1`,
      [req.user.id],
    );

    if (!rows[0]) {
      return res.status(404).json({
        error: 'Akun tidak ditemukan.',
      });
    }

    return res.json({
      user: rows[0],
      message: 'Profil berhasil diperbarui.',
    });
  } catch (error) {
    return next(error);
  }
});

// GANTI PASSWORD
router.post('/change-password', authenticate, async (req, res, next) => {
  try {
    const input = changePasswordSchema.parse(req.body);

    if (input.current_password === input.new_password) {
      return res.status(400).json({
        error: 'Password baru harus berbeda dari password lama.',
      });
    }

    const [rows] = await pool.execute(
      `SELECT id, password_hash
       FROM users
       WHERE id = ?
       LIMIT 1`,
      [req.user.id],
    );

    const user = rows[0];

    if (!user) {
      return res.status(404).json({
        error: 'Akun tidak ditemukan.',
      });
    }

    const isPasswordValid = await bcrypt.compare(
      input.current_password,
      user.password_hash,
    );

    if (!isPasswordValid) {
      return res.status(400).json({
        error: 'Password lama tidak benar.',
      });
    }

    const passwordHash = await bcrypt.hash(
      input.new_password,
      Number(process.env.BCRYPT_ROUNDS || 12),
    );

    const [result] = await pool.execute(
      `UPDATE users
       SET password_hash = ?,
           token_version = token_version + 1
       WHERE id = ?`,
      [passwordHash, user.id],
    );

    if (result.affectedRows !== 1) {
      return res.status(500).json({
        error: 'Password gagal diperbarui.',
      });
    }

    return res.json({
      message: 'Password berhasil diubah. Silakan login kembali.',
    });
  } catch (error) {
    if (error instanceof z.ZodError) {
      return res.status(400).json({
        error: error.issues[0]?.message || 'Data password tidak valid.',
      });
    }

    return next(error);
  }
});

module.exports = router;
</file>

<file path="kopiers_api/src/routes/campaigns.js">
const express = require('express');
const { randomBytes } = require('node:crypto');
const { z } = require('zod');

const pool = require('../config/database');
const { authenticate, authorize } = require('../middleware/auth');
const { parseJsonValue } = require('../utils/json');

const router = express.Router();

router.use(authenticate);

// ==========================================
// KONFIGURASI SEGMENTASI
// ==========================================

const TARGET_DIMENSIONS = {
  activity: ['new', 'active', 'inactive'],
  loyalty: ['none', 'bronze', 'silver', 'gold', 'platinum'],
  customer_value: ['low', 'medium', 'high'],
};

const DEFAULT_RULES = {
  active_days: 30,
  new_customer_days: 30,
  loyal_min_transactions: 10,
  high_value_amount: 500000,
};

// ==========================================
// MENGAMBIL ATURAN SEGMENTASI
// ==========================================

async function getSegmentationRules(connection) {
  const [settings] = await connection.execute(
    `SELECT setting_value
     FROM application_settings
     WHERE setting_key = ?`,
    ['segmentation']
  );

  const storedRules = parseJsonValue(
    settings[0]?.setting_value,
    DEFAULT_RULES
  );

  return {
    active_days: Number(
      storedRules.active_days ?? DEFAULT_RULES.active_days
    ),

    new_customer_days: Number(
      storedRules.new_customer_days ??
      DEFAULT_RULES.new_customer_days
    ),

    loyal_min_transactions: Number(
      storedRules.loyal_min_transactions ??
      DEFAULT_RULES.loyal_min_transactions
    ),

    high_value_amount: Number(
      storedRules.high_value_amount ??
      DEFAULT_RULES.high_value_amount
    ),
  };
}

// ==========================================
// KONDISI SQL BERDASARKAN DIMENSI
// ==========================================

function getTargetCondition(dimension, value, rules) {
  if (!TARGET_DIMENSIONS[dimension]?.includes(value)) {
    throw new Error('Target segmentasi tidak valid.');
  }

  // ----------------------------------------
  // 1. ACTIVITY
  // ----------------------------------------

  if (dimension === 'activity') {
    if (value === 'new') {
      return {
        sql: `
          c.joined_at >= DATE_SUB(
            NOW(), INTERVAL ? DAY
          )
        `,
        params: [rules.new_customer_days],
      };
    }

    if (value === 'active') {
      return {
        sql: `
          c.joined_at < DATE_SUB(
            NOW(), INTERVAL ? DAY
          )
          AND stats.last_purchase >= DATE_SUB(
            NOW(), INTERVAL ? DAY
          )
        `,
        params: [
          rules.new_customer_days,
          rules.active_days,
        ],
      };
    }

    return {
      sql: `
        c.joined_at < DATE_SUB(
          NOW(), INTERVAL ? DAY
        )
        AND (
          stats.last_purchase IS NULL
          OR stats.last_purchase < DATE_SUB(
            NOW(), INTERVAL ? DAY
          )
        )
      `,
      params: [
        rules.new_customer_days,
        rules.active_days,
      ],
    };
  }

  // ----------------------------------------
  // 2. LOYALTY
  // ----------------------------------------

  if (dimension === 'loyalty') {
    const ranges = {
      none: {
        min: 0,
        max: 0,
      },
      bronze: {
        min: 1,
        max: 4,
      },
      silver: {
        min: 5,
        max: 9,
      },
      gold: {
        min: 10,
        max: 19,
      },
      platinum: {
        min: 20,
        max: null,
      },
    };

    const range = ranges[value];

    if (range.max === null) {
      return {
        sql: `
          COALESCE(stats.purchase_count, 0) >= ?
        `,
        params: [range.min],
      };
    }

    return {
      sql: `
        COALESCE(stats.purchase_count, 0) >= ?
        AND COALESCE(stats.purchase_count, 0) <= ?
      `,
      params: [range.min, range.max],
    };
  }

  // ----------------------------------------
  // 3. CUSTOMER VALUE
  // ----------------------------------------

  const valueRanges = {
    low: {
      min: 0,
      max: 249999.99,
    },
    medium: {
      min: 250000,
      max: 499999.99,
    },
    high: {
      min: 500000,
      max: null,
    },
  };

  const range = valueRanges[value];

  if (range.max === null) {
    return {
      sql: `
        COALESCE(stats.lifetime_value, 0) >= ?
      `,
      params: [range.min],
    };
  }

  return {
    sql: `
      COALESCE(stats.lifetime_value, 0) >= ?
      AND COALESCE(stats.lifetime_value, 0) <= ?
    `,
    params: [range.min, range.max],
  };
}

// ==========================================
// REFRESH AUDIENS KAMPANYE
// ==========================================

async function refreshCampaignAudience(
  connection,
  campaignId,
  targetDimension,
  targetSegment,
  rules
) {
  const condition = getTargetCondition(
    targetDimension,
    targetSegment,
    rules
  );

  // Hapus snapshot audiens lama.
  // Riwayat voucher dan transaksi tetap aman.
  await connection.execute(
    `DELETE FROM campaign_audiences
     WHERE campaign_id = ?`,
    [campaignId]
  );

  // Masukkan pelanggan sesuai target kampanye.
  const [result] = await connection.execute(
    `INSERT IGNORE INTO campaign_audiences
       (campaign_id, customer_id)
     SELECT ?, c.id
     FROM customers c
     INNER JOIN users u
       ON u.id = c.user_id
     LEFT JOIN (
       SELECT
         customer_id,
         COUNT(*) AS purchase_count,
         COALESCE(SUM(total_amount), 0) AS lifetime_value,
         MAX(created_at) AS last_purchase
       FROM transactions
       WHERE status = 'completed'
       GROUP BY customer_id
     ) stats
       ON stats.customer_id = c.id
     WHERE u.is_active = TRUE
       AND (${condition.sql})`,
    [
      campaignId,
      ...condition.params,
    ]
  );

  const [countRows] = await connection.execute(
    `SELECT COUNT(*) AS audience_count
     FROM campaign_audiences
     WHERE campaign_id = ?`,
    [campaignId]
  );

  return {
    audience_count: Number(countRows[0].audience_count),
    inserted_count: result.affectedRows,
  };
}

