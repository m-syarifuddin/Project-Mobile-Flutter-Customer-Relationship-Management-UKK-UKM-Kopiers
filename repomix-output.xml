const express = require('express');
const { randomUUID } = require('node:crypto');
const fs = require('node:fs/promises');
const path = require('node:path');
const { z } = require('zod');
const pool = require('../config/database');
const { authenticate, authorize } = require('../middleware/auth');

const router = express.Router();
const productImageDirectory = path.resolve(__dirname, '../../uploads/products');
const imagePathSchema = z.string().regex(/^\/products\/images\/[0-9a-f-]{36}\.(jpg|png|webp)$/i);
const imageTypes = {
  'image/jpeg': {
    extension: 'jpg',
    matches: (image) => image[0] === 0xff && image[1] === 0xd8 && image[2] === 0xff
  },
  'image/png': {
    extension: 'png',
    matches: (image) => image.subarray(0, 8).equals(
      Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a])
    )
  },
  'image/webp': {
    extension: 'webp',
    matches: (image) => image.toString('ascii', 0, 4) === 'RIFF'
      && image.toString('ascii', 8, 12) === 'WEBP'
  }
};
const productSchema = z.object({
  name: z.string().trim().min(1).max(140),
  description: z.string().trim().max(500).optional().nullable(),
  price: z.number().finite().nonnegative(),
  image_url: imagePathSchema.optional().nullable()
});

router.use(authenticate);
router.get('/', async (req, res, next) => {
  try {
    const [rows] = await pool.execute(
      `SELECT id, name, description, price, image_url, is_active, created_at
       FROM products WHERE is_active = TRUE ORDER BY name`
    );
    return res.json({ data: rows });
  } catch (error) {
    return next(error);
  }
});

router.post(
  '/images',
  authorize('admin'),
  express.raw({ type: Object.keys(imageTypes), limit: '5mb' }),
  async (req, res, next) => {
    try {
      const image = imageTypes[req.get('content-type')];
      if (!Buffer.isBuffer(req.body) || req.body.length === 0 || !image?.matches(req.body)) {
        return res.status(400).json({ error: 'Pilih gambar JPG, PNG, atau WebP yang valid.' });
      }
      const filename = `${randomUUID()}.${image.extension}`;
      await fs.mkdir(productImageDirectory, { recursive: true });
      await fs.writeFile(path.join(productImageDirectory, filename), req.body, { flag: 'wx' });
      return res.status(201).json({ image_url: `/products/images/${filename}` });
    } catch (error) {
      return next(error);
    }
  }
);

router.get('/images/:filename', async (req, res, next) => {
  try {
    const filename = z.string().regex(/^[0-9a-f-]{36}\.(jpg|png|webp)$/i).parse(req.params.filename);
    const imageUrl = `/products/images/${filename}`;
    const [products] = await pool.execute(
      'SELECT id FROM products WHERE image_url = ? LIMIT 1',
      [imageUrl]
    );
    if (!products[0]) return res.status(404).json({ error: 'Foto produk tidak ditemukan.' });
    const filePath = path.join(productImageDirectory, filename);
    await fs.access(filePath);
    res.set('Cache-Control', 'private, max-age=3600');
    return res.sendFile(filePath);
  } catch (error) {
    if (error.code === 'ENOENT') return res.status(404).json({ error: 'Foto produk tidak ditemukan.' });
    return next(error);
  }
});

router.post('/', authorize('admin'), async (req, res, next) => {
  try {
    const input = productSchema.parse(req.body);
    const [result] = await pool.execute(
      'INSERT INTO products (name, description, price, image_url) VALUES (?, ?, ?, ?)',
      [input.name, input.description || null, input.price, input.image_url || null]
    );
    return res.status(201).json({ id: result.insertId, message: 'Produk berhasil dibuat.' });
  } catch (error) {
    return next(error);
  }
});

router.patch('/:id', authorize('admin'), async (req, res, next) => {
  try {
    const id = z.coerce.number().int().positive().parse(req.params.id);
    const input = productSchema.partial().parse(req.body);
    if (!Object.keys(input).length) return res.status(400).json({ error: 'Tidak ada perubahan yang dikirim.' });
    const fields = Object.keys(input);
    const values = fields.map((field) => input[field] === '' ? null : input[field]);
    const [result] = await pool.execute(
      `UPDATE products SET ${fields.map((field) => `${field} = ?`).join(', ')} WHERE id = ?`,
      [...values, id]
    );
    if (!result.affectedRows) return res.status(404).json({ error: 'Produk tidak ditemukan.' });
    return res.json({ message: 'Produk berhasil diperbarui.' });
  } catch (error) {
    return next(error);
  }
});

router.delete('/:id', authorize('admin'), async (req, res, next) => {
  try {
    const id = z.coerce.number().int().positive().parse(req.params.id);
    const [result] = await pool.execute('UPDATE products SET is_active = FALSE WHERE id = ?', [id]);
    if (!result.affectedRows) return res.status(404).json({ error: 'Produk tidak ditemukan.' });
    return res.json({ message: 'Produk dinonaktifkan.' });
  } catch (error) {
    return next(error);
  }
});

module.exports = router;
</file>

<file path="kopiers_api/src/routes/segments.js">
const express = require('express');
const { z } = require('zod');
const pool = require('../config/database');
const { authenticate, authorize } = require('../middleware/auth');
const { parseJsonValue } = require('../utils/json');
const { classifyLoyalty } = require('../utils/loyalty');
const { getRfmCustomers } = require('../services/rfm-customers');
const { RFM_SEGMENTS } = require('../utils/rfm');

const router = express.Router();

router.use(authenticate, authorize('admin'));

const DEFAULT_RULES = {
  active_days: 30,
  new_customer_days: 30,
  loyal_min_transactions: 10,
  high_value_amount: 500000,
};

const LOYALTY_RULES = {
  bronze: { min: 1, max: 4 },
  silver: { min: 5, max: 9 },
  gold: { min: 10, max: 19 },
  platinum: { min: 20, max: null },
};

const VALUE_RULES = {
  low: { min: 0, max: 249999 },
  medium: { min: 250000, max: 499999 },
  high: { min: 500000, max: null },
};

async function getRules() {
  const [rows] = await pool.execute(
    `SELECT setting_value
     FROM application_settings
     WHERE setting_key = ?`,
    ['segmentation']
  );

  const stored = parseJsonValue(
    rows[0]?.setting_value,
    DEFAULT_RULES
  );

  return {
    ...DEFAULT_RULES,
    ...stored,
  };
}

function classifyActivity(joinedAt, lastPurchase, rules, now) {
  const joined = joinedAt ? new Date(joinedAt) : null;
  const last = lastPurchase ? new Date(lastPurchase) : null;
  const currentTime = now.getTime();

  const newLimit =
    rules.new_customer_days * 24 * 60 * 60 * 1000;

  const activeLimit =
    rules.active_days * 24 * 60 * 60 * 1000;

  if (joined && currentTime - joined.getTime() <= newLimit) {
    return 'new';
  }

  if (last && currentTime - last.getTime() <= activeLimit) {
    return 'active';
  }

  return 'inactive';
}

function classifyCustomerValue(lifetimeValue) {
  if (lifetimeValue >= 500000) return 'high';
  if (lifetimeValue >= 250000) return 'medium';

  return 'low';
}

// Mengambil aturan segmentasi.
router.get('/rules', async (req, res, next) => {
  try {
    return res.json({
      rules: await getRules(),
      loyalty_rules: LOYALTY_RULES,
      value_rules: VALUE_RULES,
    });
  } catch (error) {
    return next(error);
  }
});

// Memperbarui aturan segmentasi.
router.put('/rules', async (req, res, next) => {
  try {
    const input = z.object({
      active_days: z.number().int().min(1).max(365),
      new_customer_days: z.number().int().min(1).max(365),
      loyal_min_transactions: z.number().int().min(1).max(1000),
      high_value_amount: z.number().nonnegative(),
    }).parse(req.body);

    await pool.execute(
      `INSERT INTO application_settings
        (setting_key, setting_value, updated_by)
       VALUES ('segmentation', ?, ?)
       ON DUPLICATE KEY UPDATE
        setting_value = VALUES(setting_value),
        updated_by = VALUES(updated_by)`,
      [JSON.stringify(input), req.user.id]
    );

    return res.json({
      rules: input,
      loyalty_rules: LOYALTY_RULES,
      value_rules: VALUE_RULES,
      message: 'Aturan segmentasi berhasil diperbarui.',
    });
  } catch (error) {
    return next(error);
  }
});

// Daftar pelanggan dengan segmen aktivitas, loyalitas, nilai, dan RFM.
router.get('/', async (req, res, next) => {
  try {
    const filters = z.object({
      segment: z.enum([
        'new',
        'active',
        'inactive',
      ]).optional(),

      loyalty: z.enum([
        'none',
        'bronze',
        'silver',
        'gold',
        'platinum',
      ]).optional(),

      customer_value: z.enum([
        'low',
        'medium',
        'high',
      ]).optional(),
    }).parse(req.query);

    const rules = await getRules();

    const now = new Date();
    const data = (await getRfmCustomers(now)).map((row) => {
      const activitySegment = classifyActivity(
        row.joined_at,
        row.last_purchase,
        rules,
        now
      );

      const loyaltyTier =
        classifyLoyalty(row.transaction_count);

      const customerValue =
        classifyCustomerValue(row.lifetime_value);

      return {
        ...row,
        // Kompatibilitas dengan kode lama.
        segment: activitySegment,

        // Klasifikasi baru.
        activity_segment: activitySegment,
        loyalty_tier: loyaltyTier,
        customer_value: customerValue,
      };
    });

    const filtered = data.filter((row) => {
      if (
        filters.segment &&
        row.activity_segment !== filters.segment
      ) return false;

      if (
        filters.loyalty &&
        row.loyalty_tier !== filters.loyalty
      ) return false;

      if (
        filters.customer_value &&
        row.customer_value !== filters.customer_value
      ) return false;

      return true;
    });

    const summary = {
      activity: {
        new: 0,
        active: 0,
        inactive: 0,
      },

      loyalty: {
        none: 0,
        bronze: 0,
        silver: 0,
        gold: 0,
        platinum: 0,
      },

      customer_value: {
        low: 0,
        medium: 0,
        high: 0,
      },

      rfm: Object.fromEntries(
        RFM_SEGMENTS.map((segment) => [segment, 0])
      ),

      total: data.length,
    };

    for (const customer of data) {
      summary.activity[customer.activity_segment]++;
      summary.loyalty[customer.loyalty_tier]++;
      summary.customer_value[customer.customer_value]++;
      summary.rfm[customer.rfm_segment]++;
    }

    return res.json({
      summary,
      rules,
      data: filtered,
    });

  } catch (error) {
    return next(error);
  }
});

module.exports = router;
</file>

